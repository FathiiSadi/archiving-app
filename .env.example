APP_NAME="أرشيف دال"
APP_ENV=local
APP_KEY=
# In production: APP_ENV=production, APP_DEBUG=false, APP_URL=https://… (HTTPS is then enforced and
# session cookies are marked Secure automatically).
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Amman
APP_FAKER_LOCALE=ar_JO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — PostgreSQL on Neon.
# Fill these from the Neon console (Connection details → Laravel / parameters).
# Neon requires TLS, so keep DB_SSLMODE=require.
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
# `neon env pull` writes DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED (direct); the app reads
# those automatically. DB_URL / DB_DIRECT_URL override them when set.
DB_URL=
# Direct (non -pooler) URL, used for migrations: php artisan migrate --database=pgsql_direct
DB_DIRECT_URL=
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require
# Required when DB_URL points at a Neon -pooler endpoint.
DB_EMULATE_PREPARES=true
# Reuse database connections between requests (recommended when the database is remote).
DB_PERSISTENT=false

# First admin account created by `php artisan db:seed`. Use a strong password (10+ characters,
# letters and numbers) and clear ADMIN_PASSWORD from this file after seeding.
ADMIN_NAME="مدير النظام"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Daily backup (php artisan dal:backup, run by the scheduler). Use a private disk.
BACKUP_DISK=backups
BACKUP_KEEP=30
BACKUP_TIME=02:30

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
